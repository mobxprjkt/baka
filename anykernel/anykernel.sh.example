#!/sbin/sh
# AnyKernel3 installer template.
# Rename this file to anykernel.sh and configure it for your exact device.
# Do NOT flash this template as-is.

properties() { '
kernel.string=GKI 5.15 - SukiSU Nova
do.devicecheck=1
do.modules=0
do.systemless=1
do.cleanup=1
do.cleanuponabort=0
device.name1=REPLACE_ME
'; }

# IMPORTANT:
# Configure the correct boot partition and A/B slot handling for your device.
# Add the tested AnyKernel3 install flow required by your device.
# This template intentionally does not write to any partition.
